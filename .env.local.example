# ─── Supabase (indexer) ───────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Pinata (IPFS) ────────────────────────────────────────────────────────────
PINATA_API_KEY=
PINATA_API_SECRET=

# ─── Anthropic (agent generation, and legacy arbitration) ─────────────────────
ANTHROPIC_API_KEY=

# ─── Agent wallet on Arc ──────────────────────────────────────────────────────
# Raw key in an env var. Fine for testnet; mainnet needs Circle developer-controlled wallets.
AGENT_PRIVATE_KEY=

# ─── GenLayer arbitration (optional) ──────────────────────────────────────────
# Everything below is off by default. Without NEXT_PUBLIC_GENLAYER_ARBITRATION=true
# the app keeps using the existing advisory Claude arbitration and none of these
# are read.

# Flip the UI over to on-chain arbitration.
NEXT_PUBLIC_GENLAYER_ARBITRATION=false

# Address of the deployed arbitration Intelligent Contract. See genlayer/README.md.
GENLAYER_ARBITRATION_ADDRESS=

# Relayer wallet on GenLayer testnet. Needs GEN from the faucet to pay for consensus.
GENLAYER_PRIVATE_KEY=

# Gateway the validators fetch the deliverable from.
# MUST return 200 directly — the in-contract fetch does not follow redirects, so a
# gateway that 301s will fail inside consensus. Verify before changing this.
GENLAYER_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs

# Consensus rotations before a write gives up. Protocol default is 3; testnet
# leader timeouts are common enough that 8 lands noticeably more often.
GENLAYER_MAX_ROTATIONS=8
